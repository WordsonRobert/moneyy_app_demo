# Copy this file to ".env" and fill in your key, then restart `npm run dev`.

# Google Maps JavaScript API key (with the "Places API" + "Maps JavaScript API" enabled).
# Get one at: https://console.cloud.google.com/google/maps-apis
# If left blank, the app falls back to a curated "things to do" list so the prototype still works.
VITE_GOOGLE_MAPS_API_KEY=
