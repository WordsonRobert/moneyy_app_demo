# Copy this file to ".env" and fill in what you have, then restart `npm run dev`.
# Everything here is client-side/public config (not secret) — the app runs fine
# with these blank (demo mode); filling them in switches on the real features.

# ── Firebase (real phone OTP + shared likes & comments) ──────────────────────
# Create a project at https://console.firebase.google.com → Project settings →
# "Your apps" → Web app → copy the config values below.
# Then enable: Authentication → Sign-in method → Phone, and Firestore Database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Google Maps (live "things to do nearby") ─────────────────────────────────
# https://console.cloud.google.com/google/maps-apis — enable Maps JavaScript API
# + Places API. If blank, the app falls back to a curated nearby list.
VITE_GOOGLE_MAPS_API_KEY=
